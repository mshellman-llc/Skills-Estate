{
  "format": 1,
  "purpose": "Reference delivery lifecycle; the executed agreement and accepted project plan determine applicable gates.",
  "stages": [
    {
      "id": "S2D",
      "name": "Handoff",
      "gate_key": "brief_accepted",
      "gate": "Handoff brief accepted by the delivery team",
      "gate_holder": "delivery team",
      "owner": "sales-to-delivery-handoff"
    },
    {
      "id": "01",
      "name": "Mobilize",
      "gate_key": "charter_signed",
      "gate": "Project Charter delivered and signed off",
      "gate_holder": "client",
      "owner": "delivery-kickoff"
    },
    {
      "id": "02",
      "name": "Analyze",
      "gate_key": "requirements_cosigned",
      "gate": "Requirements Document co-signed",
      "gate_holder": "client",
      "owner": "requirements-backlog; journey-mapping when needed"
    },
    {
      "id": "03",
      "name": "Design",
      "gate_key": "sdd_cosigned",
      "gate": "Solution Design Document co-signed",
      "gate_holder": "client",
      "owner": "system-design; solution-brief for delivery feasibility"
    },
    {
      "id": "04",
      "name": "Build",
      "gate_key": "build_complete",
      "gate": "Build complete in sandbox",
      "gate_holder": "delivery team",
      "owner": "the configured project implementation workflow"
    },
    {
      "id": "05",
      "name": "Validate",
      "gate_key": "go_no_go",
      "gate": "Go / no-go co-signed",
      "gate_holder": "client",
      "owner": "acceptance-testing"
    },
    {
      "id": "06",
      "name": "Deploy",
      "gate_key": "golive_acceptance",
      "gate": "Go-Live Acceptance issued (deemed-acceptance clock per the SOW clause)",
      "gate_holder": "client",
      "owner": "cutover-closeout"
    },
    {
      "id": "06b",
      "name": "Closeout",
      "gate_key": "hypercare_closeout",
      "gate": "Hypercare Closeout delivered (lessons and asset harvest complete)",
      "gate_holder": "delivery team",
      "owner": "cutover-closeout"
    }
  ]
}
