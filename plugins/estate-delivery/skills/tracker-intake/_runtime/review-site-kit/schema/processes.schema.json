{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build page content",
  "type": "object",
  "required": ["format", "lanes"],
  "properties": {
    "format": {"const": 1},
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "steps"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "lead": {"type": "string"},
          "steps": {
            "type": "array",
            "items": {"type": "object", "required": ["id", "label", "text"],
                      "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "text": {"type": "string"},
                                     "tickets": {"type": "array", "items": {"type": "string"}}}}
          }
        }
      }
    },
    "design": {
      "type": "array",
      "items": {"type": "object", "required": ["title", "rows"],
                "properties": {"title": {"type": "string"},
                               "rows": {"type": "array", "items": {"type": "object", "required": ["label", "text"],
                                        "properties": {"label": {"type": "string"}, "text": {"type": "string"}}}}}}
    }
  }
}
