{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow page content",
  "type": "object",
  "required": ["format", "roles"],
  "properties": {
    "format": {"const": 1},
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "steps"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "lead": {"type": "string"},
          "steps": {
            "type": "array",
            "items": {"type": "object", "required": ["label", "question"],
                      "properties": {"label": {"type": "string"}, "question": {"type": "string"},
                                     "today": {"type": "string"}, "behind": {"type": "string"},
                                     "handoff": {"type": "string"}, "open": {"type": "string"}}}
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {"type": "object", "required": ["area", "today", "after"],
                "properties": {"area": {"type": "string"}, "today": {"type": "string"}, "after": {"type": "string"},
                               "tickets": {"type": "array", "items": {"type": "string"}}}}
    }
  }
}
