#!/bin/bash
# Prove that a GitHub pipeline branch exists and cannot be deleted. This is
# separate from local estate.protected, which governs agent behavior but cannot
# stop GitHub's delete-after-merge setting or a browser action.

set -eu

JSON=0
BRANCH=""
while [ $# -gt 0 ]; do
  case "$1" in
    --branch) BRANCH="${2:-}"; shift ;;
    --json) JSON=1 ;;
    -h|--help)
      sed -n '1,10p' "$0"
      exit 0
      ;;
    *) printf 'estate-devops-branch-status: unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

emit_error() { # exit-code message
  local rc="$1"; shift
  if [ "$JSON" = "1" ] && command -v jq >/dev/null 2>&1; then
    jq -cn --arg branch "$BRANCH" --arg error "$*" \
      '{ok:false,branch:$branch,error:$error}'
  else
    printf 'UNSAFE: %s\n' "$*" >&2
  fi
  exit "$rc"
}

[ -n "$BRANCH" ] || emit_error 2 "--branch is required"
command -v gh >/dev/null 2>&1 || emit_error 2 "gh is required"
command -v jq >/dev/null 2>&1 || emit_error 2 "jq is required"

REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) \
  || emit_error 2 "could not resolve the GitHub repository"
[ -n "$REPO" ] || emit_error 2 "GitHub returned no repository name"
ENCODED=$(jq -rn --arg value "$BRANCH" '$value|@uri')

BRANCH_JSON=$(gh api -X GET "repos/$REPO/branches/$ENCODED" 2>/dev/null) \
  || emit_error 2 "could not read remote pipeline branch '$BRANCH'; it may be missing or GitHub state may be unavailable"
printf '%s' "$BRANCH_JSON" | jq -e '.protected == true' >/dev/null 2>&1 \
  || emit_error 3 "remote pipeline branch '$BRANCH' is not protected"

MECHANISM=""
PROTECTION=$(gh api -X GET "repos/$REPO/branches/$ENCODED/protection" 2>/dev/null || echo "")
if [ -n "$PROTECTION" ] \
   && printf '%s' "$PROTECTION" | jq -e '.allow_deletions.enabled == false' >/dev/null 2>&1; then
  MECHANISM="classic-protection"
else
  RULES=$(gh api -X GET "repos/$REPO/rules/branches/$ENCODED" -f per_page=100 2>/dev/null || echo "")
  if [ -n "$RULES" ] \
     && printf '%s' "$RULES" | jq -e 'type == "array" and any(.[]; .type == "deletion")' >/dev/null 2>&1; then
    MECHANISM="ruleset"
  fi
fi

[ -n "$MECHANISM" ] || emit_error 3 \
  "remote pipeline branch '$BRANCH' is not proven protected against deletion"

if [ "$JSON" = "1" ]; then
  jq -cn --arg branch "$BRANCH" --arg repository "$REPO" --arg mechanism "$MECHANISM" \
    '{ok:true,branch:$branch,repository:$repository,deletionBlocked:true,mechanism:$mechanism}'
else
  printf 'PERSISTENT: %s/%s (%s blocks deletion)\n' "$REPO" "$BRANCH" "$MECHANISM"
fi
