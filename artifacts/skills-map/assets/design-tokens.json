  "aliases": {
    "$comment": "Semantic name -> token key. Renderers use these so a CSS variable rename does not ripple through every producer. Both loaders merge them into hex/bare.",
    "navy": "deepNavy",
    "teal": "teal",
    "tealLight": "lightTeal",
    "accentOnDark": "lightTeal",
    "offWhite": "offWhite",
    "sand": "sand",
    "sandDivider": "darkSand",
    "divider": "border",
    "blueGray": "blueGray",
    "textPrimary": "fg",
    "textSecondary": "fgSecondary",
    "textMuted": "fgMuted",
    "white": "white",
    "cardOnDark": "lighterNavy",
    "linkHover": "steelBlue",
    "tagFill": "tealPale"
  },
  "rules": {
    "warmSurfacesAllowed": [
      "#F7F5F0",
      "#DEDAD0"
    ],
    "warmAccentsAllowed": false,
    "warmAccentNote": "Sand is the only warm surface on the brand. No orange, amber, or warm red accents. This rules out amber alert boxes; a warning is told by its label.",
    "borderWidthPx": 1,
    "borderNeverBlack": true,
    "borderColorsBySurface": {
      "light": "#E0E4EA",
      "sand": "#DEDAD0"
    },
    "radius": {
      "allowedPx": [
        4,
        8
      ],
      "defaultPx": 8,
      "smallPx": 4,
      "capPx": 8,
      "pillPx": 999,
      "capNote": "colors_and_type.css: 'Cap at 8px.' --radius:8px is the default for tags, buttons, cards, AND inputs; --radius-sm:4px is the small variant.",
      "pillUsage": "avatars, dots, and status pucks only",
      "pillNote": "colors_and_type.css: the circle is 'reserved for visual assets like avatars, dots, status pucks - never used on buttons, cards, or inputs'.",
      "supersedes": "An earlier 8-to-12px card band in this file was wrong; it came from a paraphrase, not from the CSS."
    },
    "headingCase": "sentence",
    "labelTransform": "uppercase",
    "labelTrackingEm": 0.14,
    "bodyAlign": "left",
    "bodyAlignNote": "Never center a long paragraph.",
    "titleUnderline": false,
    "footer": {
      "required": false,
      "logo": null,
      "pageNumber": "content-dependent"
    },
    "deckConstruction": {
      "mode": "tokens",
      "requireOfficialTemplate": false,
      "note": "Use content-driven composition and inspect every rendered slide. Do not add a logo or company footer."
    },
    "eyebrow": {
      "brandHex": "#9A9890",
      "brandContrastOnWhite": 2.89,
      "defaultHex": "#5A5A55",
      "defaultContrastOnWhite": 6.93,
      "wcagLargeTextMin": 3.0,
      "status": "accessible-default",
      "note": "Use the secondary text token on light surfaces. Muted gray is decorative only; never use it for required text.",
      "onDarkHex": "#4AA8A8",
      "onDarkNote": "colors_and_type.css: .on-dark .eyebrow uses --eyebrow-on-dark, which is --light-teal #4AA8A8. The contrast tradeoff below applies to LIGHT surfaces only."
    },
    "shadow": {
      "allowed": true,
      "maxOffsetPx": 4,
      "note": "colors_and_type.css ships --shadow-xs/-sm/(default)/-lg, described as 'restrained, max 4px offset per brand'. Shadows are not banned; oversized ones are.",
      "tokens": {
        "xs": "0 1px 2px rgba(8, 15, 40, 0.04)",
        "sm": "0 1px 3px rgba(8, 15, 40, 0.06), 0 1px 2px rgba(8, 15, 40, 0.04)",
        "default": "0 2px 4px rgba(8, 15, 40, 0.06), 0 4px 12px rgba(8, 15, 40, 0.06)",
        "lg": "0 4px 8px rgba(8, 15, 40, 0.08), 0 4px 24px rgba(8, 15, 40, 0.08)"
      },
      "source": "colors_and_type.css"
    }
  },
  "type": {
    "family": "Plus Jakarta Sans",
    "numerals": "tabular",
    "monospaceInBodies": false
  },
  "blocked": {
    "$comment": "Known off-brand colors remain blocked even when they resemble a canonical token.",
    "knownOffBrand": {
      "reason": "Use the mapped canonical token.",
      "hexes": [
        "#1A1A1A",
        "#5A6478",
        "#B23A48"
      ],
      "replacedBy": {
        "#1A1A1A": "#111118",
        "#5A6478": "#5A5A55",
        "#B23A48": "#080F28"
      }
    }
  }
}
