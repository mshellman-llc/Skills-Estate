#!/bin/bash
# Compare the shared development branch with its latest successful centralized
# deployment receipt. GitHub Deployments is the cross-clone authority; local
# deploy logs cannot serialize several agents.

set -eu

JSON=0
while [ $# -gt 0 ]; do
  case "$1" in
    --json) JSON=1 ;;
    -h|--help)
      sed -n '1,12p' "$0"
      exit 0
      ;;
    *) printf 'estate-devops-shared-status: unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

die() {
  if [ "$JSON" = "1" ] && command -v jq >/dev/null 2>&1; then
    jq -cn --arg error "$*" '{ok:false,error:$error}'
  else
    printf 'UNVERIFIED: %s\n' "$*" >&2
  fi
  exit 2
}

command -v git >/dev/null 2>&1 || die "git is required"
command -v gh >/dev/null 2>&1 || die "gh is required to read centralized deployment receipts"
command -v jq >/dev/null 2>&1 || die "jq is required"
git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"

[ "$(git config --get estate.delivery 2>/dev/null || echo direct)" = "devops-center" ] \
  || die "estate.delivery is not devops-center"
[ "$(git config --get estate.devops.workmodel 2>/dev/null || echo isolated)" = "shared" ] \
  || die "estate.devops.workmodel is not shared"
[ "$(git config --get estate.host 2>/dev/null || echo github)" = "github" ] \
  || die "shared DevOps Center receipts currently require estate.host=github"

BRANCH=$(git config --get estate.devops.integrationbranch 2>/dev/null || echo "")
ENVIRONMENT=$(git config --get estate.devops.environment 2>/dev/null || echo "")
[ -n "$BRANCH" ] || die "estate.devops.integrationbranch is unset"
[ -n "$ENVIRONMENT" ] || die "estate.devops.environment is unset"

# Refresh exactly the integration ref. A cached remote ref is not concurrency
# evidence. No prompt is permitted because this command is called from guards.
REFSPEC="+refs/heads/$BRANCH:refs/remotes/origin/$BRANCH"
if command -v perl >/dev/null 2>&1; then
  GIT_TERMINAL_PROMPT=0 perl -e 'alarm shift; exec @ARGV or exit 127' 12 \
    git fetch --quiet origin "$REFSPEC" >/dev/null 2>&1 \
    || die "could not refresh origin/$BRANCH"
else
  GIT_TERMINAL_PROMPT=0 git fetch --quiet origin "$REFSPEC" >/dev/null 2>&1 \
    || die "could not refresh origin/$BRANCH"
fi

REMOTE_SHA=$(git rev-parse --verify "origin/$BRANCH" 2>/dev/null) \
  || die "origin/$BRANCH does not resolve"
REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) \
  || die "could not resolve the GitHub repository; check gh authentication"
[ -n "$REPO" ] || die "GitHub returned no repository name"

DEPLOYMENTS=$(gh api -X GET "repos/$REPO/deployments" \
  -f "environment=$ENVIRONMENT" -f per_page=50 2>/dev/null) \
  || die "could not read deployments for GitHub environment '$ENVIRONMENT'"
printf '%s' "$DEPLOYMENTS" | jq -e 'type == "array"' >/dev/null 2>&1 \
  || die "GitHub deployments response was not an array"

DEPLOYED_SHA=""
DEPLOYMENT_ID=""
while IFS=$'\t' read -r ID SHA; do
  [ -n "$ID" ] || continue
  STATUSES=$(gh api -X GET "repos/$REPO/deployments/$ID/statuses" -f per_page=10 2>/dev/null) \
    || die "could not read status for GitHub deployment $ID"
  STATE=$(printf '%s' "$STATUSES" | jq -er 'if type == "array" then (.[0].state // "") else error("not an array") end' 2>/dev/null) \
    || die "GitHub deployment $ID returned no readable status"
  if [ "$STATE" = "success" ]; then
    DEPLOYED_SHA="$SHA"
    DEPLOYMENT_ID="$ID"
    break
  fi
done <<EOF
$(printf '%s' "$DEPLOYMENTS" | jq -r '.[] | [(.id|tostring), (.sha // "")] | @tsv')
EOF

[ -n "$DEPLOYED_SHA" ] || die "no successful deployment receipt exists for '$ENVIRONMENT'"

if [ "$REMOTE_SHA" = "$DEPLOYED_SHA" ]; then
  if [ "$JSON" = "1" ]; then
    jq -cn --arg branch "$BRANCH" --arg environment "$ENVIRONMENT" \
      --arg remoteSha "$REMOTE_SHA" --arg deployedSha "$DEPLOYED_SHA" \
      --arg deploymentId "$DEPLOYMENT_ID" \
      '{ok:true,synced:true,branch:$branch,environment:$environment,remoteSha:$remoteSha,deployedSha:$deployedSha,deploymentId:$deploymentId}'
  else
    printf 'SYNCED: origin/%s = %s deployment %s at %s\n' \
      "$BRANCH" "${REMOTE_SHA:0:12}" "$DEPLOYMENT_ID" "$ENVIRONMENT"
  fi
  exit 0
fi

if [ "$JSON" = "1" ]; then
  jq -cn --arg branch "$BRANCH" --arg environment "$ENVIRONMENT" \
    --arg remoteSha "$REMOTE_SHA" --arg deployedSha "$DEPLOYED_SHA" \
    --arg deploymentId "$DEPLOYMENT_ID" \
    '{ok:true,synced:false,branch:$branch,environment:$environment,remoteSha:$remoteSha,deployedSha:$deployedSha,deploymentId:$deploymentId}'
else
  printf 'MISMATCH: origin/%s=%s but latest successful %s deployment=%s\n' \
    "$BRANCH" "${REMOTE_SHA:0:12}" "$ENVIRONMENT" "${DEPLOYED_SHA:0:12}" >&2
fi
exit 3
