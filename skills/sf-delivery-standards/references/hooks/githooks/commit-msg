#!/bin/bash
# Machine-local commit-msg hook. Armed via: git config core.hooksPath ~/.aleysian/githooks
#
# Two jobs on any commit that touches force-app/:
#
#   1. REQUIRE a ticket reference, in whatever form this project's tracker uses.
#      Ticket-first is the step agents skip most often, and without it there is no
#      audit trail from an org change back to the reason for it.
#
#   2. REJECT anything that would close or transition a ticket from a commit
#      message. Closure is a separate, gated Definition-of-Done step. See
#      guard-closing-keywords.sh for the full argument; this is the backstop that
#      catches commits typed in a terminal, which no Claude hook can see.
#
# Docs-only and config-only commits are exempt from both, by design.
#
# Then: exec the project's own commit-msg hook, if there is one. Conventional-
# commit linters live there and are none of our business to displace.

set -u

HOOKS_HOME="$(cd "$(dirname "$0")" && pwd)"
. "$HOOKS_HOME/../claude-hooks/_config.sh"
. "$HOOKS_HOME/../claude-hooks/_ticket.sh"

[ -n "$(mode)" ] || exit 0

chain_client_hook() {
  local dir; dir=$(chainhooks)
  [ -n "$dir" ] || return 0
  [ -x "$dir/commit-msg" ] || return 0
  exec "$dir/commit-msg" "$@"
}

STAGED_FORCE=$(git diff --cached --name-only --diff-filter=ACMR -- 'force-app/')
[ -z "$STAGED_FORCE" ] && { chain_client_hook "$@"; exit 0; }

# Ignore comment lines so a "#123" inside git's commented template never counts.
MSG_BODY=$(grep -v '^[[:space:]]*#' "$1")

if is_devops_center; then
  BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
  if ! is_devops_source_branch "$BRANCH"; then
    {
      echo ""
      echo "BLOCKED: DevOps Center source commits must use a configured work branch."
      echo ""
      echo "Current branch: ${BRANCH:-unknown}"
      echo "Packaging pattern: $(devops_branch_pattern)"
      is_devops_shared && echo "Development pattern: $(devops_development_branch_pattern)"
    } >&2
    exit 1
  fi
  WI_BRANCH="$BRANCH"
  is_devops_shared && WI_BRANCH=${WI_BRANCH#dev/}
  if ! printf '%s\n' "$MSG_BODY" | grep -qiE "(^|[^[:alnum:]])${WI_BRANCH}([^[:alnum:]]|$)"; then
    {
      echo ""
      echo "BLOCKED: this commit must reference its own DevOps Center work item: $WI_BRANCH"
      echo ""
      echo "A reference to another WI would associate the source with the wrong promotion."
      echo "Example: feat: describe the change ($WI_BRANCH)"
    } >&2
    exit 1
  fi
fi

TSYS=$(ticket_system)

# ── 1. Reject closing keywords and smart-commit commands ─────
#
# GitHub: `fixes #42` closes the issue on merge, before any deploy — and this loop
# never closes a ticket on merge.
# Jira: smart commits (`ABC-1 #comment ...`, `#done`, `#time 2h`) transition and
# annotate work items straight from a commit message. Same class of problem as
# `fixes #N` and for the same reason — an agent writing prose can transition a
# ticket by accident, and the transition is indistinguishable from a deliberate one
# afterwards. Use the GitHub-for-Jira app for LINKING (which needs no command); a
# transition is an explicit Rovo MCP action, taken only when the user asks.
if printf '%s\n' "$MSG_BODY" | grep -qiE '(close[sd]?|fix(e[sd])?|resolve[sd]?)[[:space:]]+#[0-9]+'; then
  {
    echo ""
    echo "BLOCKED: this commit message contains a GitHub closing keyword."
    echo ""
    printf '%s\n' "$MSG_BODY" | grep -oiE '(close[sd]?|fix(e[sd])?|resolve[sd]?)[[:space:]]+#[0-9]+' | sed 's/^/  /'
    echo ""
    echo "That closes the issue when this lands — before the deploy, and this loop never"
    echo "closes a ticket on merge (tickets stay open; closure is production/engine scope)."
    echo ""
    echo "Write 'refs #N' instead. Close a ticket only if the user explicitly asks."
  } >&2
  exit 1
fi

if [ "$TSYS" = "jira" ] && printf '%s\n' "$MSG_BODY" | grep -qiE '#(done|comment|time|resolve|close|in-progress)\b'; then
  {
    echo ""
    echo "BLOCKED: this commit message contains a Jira smart-commit command."
    echo ""
    printf '%s\n' "$MSG_BODY" | grep -oiE '#(done|comment|time|resolve|close|in-progress)\b' | sed 's/^/  /'
    echo ""
    echo "Smart commits transition and annotate work items directly from a commit message."
    echo "That is the same footgun as 'fixes #N': it skips the acceptance-criteria and"
    echo "green-light steps, and afterwards an accidental transition looks exactly like a"
    echo "deliberate one."
    echo ""
    echo "The bare key on its own line is what you want — it is all the GitHub-for-Jira"
    echo "app needs to link this commit to the work item:"
    echo ""
    echo "  feat: add hail matrix cell resolution ($(ticket_example))"
    echo ""
    echo "This loop does not transition or close tickets. If the user asks to close one,"
    echo "do it explicitly via the Rovo MCP (mcp__*__transitionJiraIssue), not from a commit."
  } >&2
  exit 1
fi

# ── 2. Require a ticket reference ────────────────────────────
[ "$TSYS" = "none" ] && { chain_client_hook "$@"; exit 0; }

PATTERN=$(ref_pattern)
if ! printf '%s\n' "$MSG_BODY" | grep -qiE "$PATTERN"; then
  {
    echo ""
    echo "BLOCKED: commits touching force-app/ must reference a $TSYS ticket."
    echo ""
    case "$TSYS" in
      github)
        echo "  refs #N    work in progress and the final squash alike"
        echo ""
        echo "  feat: add hail matrix cell resolution (refs #24)"
        echo ""
        echo "The keyword is required, not decorative: a bare '#24' does not count. Everything"
        echo "downstream reads these refs out of commit messages — the deploy annotation and"
        echo "the Definition-of-Done check — and a bare-#N scan picks issue numbers out of"
        echo "ordinary prose, which is enough to cross-link tickets nobody touched."
        if printf '%s\n' "$MSG_BODY" | grep -qE '#[0-9]+'; then
          echo ""
          echo "This message DOES mention an issue number, but without a keyword."
        fi ;;
      jira)
        echo "  The bare work-item key, anywhere in the message:"
        echo ""
        echo "  feat: add hail matrix cell resolution ($(ticket_example))"
        echo ""
        echo "No keyword needed — the key itself is what the GitHub-for-Jira app indexes to"
        echo "show this commit in the work item's development panel, and what the deploy"
        echo "annotation reads back out of history."
        echo ""
        echo "Expected pattern: $PATTERN" ;;
      pattern)
        echo "  Expected pattern: $PATTERN"
        echo "  Example: $(ticket_example)" ;;
    esac
    echo ""
    echo "Staged force-app/ files:"
    echo "$STAGED_FORCE" | sed 's/^/  /'
    echo ""
    case "$TSYS" in
      github) echo "No ticket yet?  gh issue create" ;;
      jira)   echo "No work item yet?  create it via the Atlassian Rovo MCP (mcp__*__createJiraIssue, project $(ticket_project))" ;;
    esac
  } >&2
  exit 1
fi

chain_client_hook "$@"
exit 0
