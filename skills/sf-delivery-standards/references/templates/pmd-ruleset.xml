<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aleysian default Apex ruleset — the fallback when a project has none of its own.

  RESOLUTION ORDER (see githooks/pre-commit gate 4):
    1. config/pmd-ruleset.xml in the repo    — the project's own bar wins, always
    2. this file                             — our default
    3. PMD's built-in category files         — last resort, and noisy

  Rule 1 exists so `npm run pmd` and the commit hook cannot disagree about
  thresholds. An agent that gets a clean manual run and a blocked commit concludes
  the hook is broken, and then routes around it.

  WHY THESE RULES AND NOT THE WHOLE CATEGORIES
  ═══════════════════════════════════════════
  The four built-in Apex categories include class-level aggregate rules
  (ExcessiveClassLength, CyclomaticComplexity, TooManyFields) whose defaults are
  tuned for whole classes and fire on perfectly ordinary Salesforce code — a
  selector class with twenty fields, a service with a long switch. On day one of a
  real project that produces a wall of violations nobody can act on, and the gate
  gets set to `advise` and forgotten.

  So: everything in security and errorprone (those findings are almost always
  real), the parts of bestpractices that catch actual bugs, and design rules only
  where the threshold is raised to something a Salesforce codebase can meet.

  To tighten this for a specific project, copy it to config/pmd-ruleset.xml and
  edit there. Do not edit this file per-project: it is machine-wide and shared by
  every repo that has no ruleset of its own.
-->
<ruleset name="Aleysian Apex Default"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

  <description>
    Apex rules for Aleysian delivery: security and correctness enforced, style and
    class-size metrics left to review.
  </description>

  <!-- ══ Security — all of it. CRUD/FLS and injection findings are the ones that
       become an actual incident, and none of them are stylistic. ══ -->
  <rule ref="category/apex/security.xml" />

  <!-- ══ Error-prone — all of it. These are bugs, not opinions. ══ -->
  <rule ref="category/apex/errorprone.xml" />

  <!-- ══ Best practices — the subset that catches real problems ══ -->
  <rule ref="category/apex/bestpractices.xml/ApexUnitTestClassShouldHaveAsserts" />
  <rule ref="category/apex/bestpractices.xml/ApexUnitTestShouldNotUseSeeAllDataTrue" />
  <rule ref="category/apex/bestpractices.xml/AvoidGlobalModifier" />
  <rule ref="category/apex/bestpractices.xml/AvoidLogicInTrigger" />
  <rule ref="category/apex/bestpractices.xml/DebugsShouldUseLoggingLevel" />
  <rule ref="category/apex/bestpractices.xml/UnusedLocalVariable" />

  <!-- ══ Performance — SOQL/DML in loops is the classic governor-limit failure,
       and it is mechanical to detect. ══ -->
  <!-- OperationWithLimitsInLoop superseded the three Avoid*InLoops rules in
       PMD 6.29; those deprecated aliases were removed in PMD 7. -->
  <rule ref="category/apex/performance.xml/OperationWithLimitsInLoop" />
  <rule ref="category/apex/performance.xml/EagerlyLoadedDescribeSObjectResult" />

  <!-- ══ Design — thresholds raised to what real Salesforce code looks like.
       The point is to catch the genuinely unmaintainable method, not to argue
       about a 60-line handler. ══ -->
  <rule ref="category/apex/design.xml/CyclomaticComplexity">
    <properties>
      <property name="classReportLevel"  value="60" />
      <property name="methodReportLevel" value="15" />
    </properties>
  </rule>
  <rule ref="category/apex/design.xml/ExcessiveParameterList">
    <properties><property name="minimum" value="8" /></properties>
  </rule>
  <rule ref="category/apex/design.xml/NcssMethodCount">
    <properties><property name="minimum" value="80" /></properties>
  </rule>

  <!-- Deliberately NOT included, and why — so nobody "helpfully" adds them back:

       ExcessiveClassLength / NcssTypeCount   selector and service classes in a
                                              mature org legitimately run long
       TooManyFields                          a wrapper for a 40-field object has
                                              40 fields; that is the requirement
       StdCyclomaticComplexity                duplicates CyclomaticComplexity
       category/apex/codestyle.xml            naming and formatting belong to
                                              prettier and to review, not to a
                                              blocking gate at commit time
       category/apex/documentation.xml        a comment mandate produces comments
                                              that restate the method name
  -->
</ruleset>
