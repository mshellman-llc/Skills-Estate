{
  "description": "Aleysian Salesforce delivery standards. Commands are inert outside repositories configured with aleysian.mode.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/verify-git-hooks.sh" },
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/session-status.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/guard-force-app.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/ensure-worktree-config.sh" },
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/guard-force-app-bash.sh" },
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/guard-sf-deploy.sh" },
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/guard-sf-flags.sh" },
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/guard-worktree-nesting.sh" },
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/guard-closing-keywords.sh" },
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/guard-devops-shared.sh" },
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/guard-devops-handoff.sh" },
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/guard-local-merge.sh" },
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/guard-pr-merge.sh" },
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/guard-push.sh" },
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/record-escape-hatch.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/record-validate.sh" },
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/auto-label-deploy.sh" },
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/post-merge-nudge.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "__HOME__/.aleysian/claude-hooks/stop-dod-check.sh" }
        ]
      }
    ]
  }
}
