{
  "registryVersion": "0.1.0",
  "compatibilityRule": "Preserve nine artifact names. One-Pager and Overview share the offering_communications adapter but remain distinct output contracts and depth modes.",
  "artifacts": [
    {
      "artifactType": "one_pager",
      "adapter": "offering_communications",
      "mode": "one_page",
      "decisionJob": "Qualify fit and earn the next conversation without pretending discovery is complete.",
      "primaryAudience": ["prospective buyer", "account executive"],
      "requiredDomains": ["offering definition", "fit", "trigger", "outcomes", "boundaries", "next action"],
      "terminalIfInsufficient": true,
      "fullOutput": "One-page offering communication",
      "insufficientOutput": "Offering readiness gap memo",
      "hardFails": ["unsupported outcome claim", "unresolved placeholder", "example-derived tier structure treated as universal", "no next action"],
      "referenceComponents": ["One-Pager — CPQ to Revenue Cloud Migration"]
    },
    {
      "artifactType": "overview",
      "adapter": "offering_communications",
      "mode": "overview",
      "decisionJob": "Explain the offering at summary depth so a buyer can judge relevance, boundaries, and next step.",
      "primaryAudience": ["prospective buyer", "buyer committee", "account executive"],
      "requiredDomains": ["offering definition", "fit", "problem", "outcomes", "approach", "boundaries", "proof", "next action"],
      "terminalIfInsufficient": true,
      "fullOutput": "Customer offering overview",
      "insufficientOutput": "Offering readiness gap memo",
      "hardFails": ["internal policy exposed as customer promise", "playbook operating detail substituted for buyer relevance", "unsupported proof", "no next action"],
      "referenceComponents": ["Overview — CPQ to Revenue Cloud Migration"]
    },
    {
      "artifactType": "discovery_brief",
      "adapter": "discovery_brief",
      "decisionJob": "Prioritize the unknowns that materially change scope, price, architecture, or the buyer decision before the call begins.",
      "primaryAudience": ["sales lead", "solution architect", "delivery or domain specialist"],
      "requiredDomains": ["known facts", "source coverage", "ranked unknowns", "scope at stake", "decision owners", "call outcome"],
      "terminalIfInsufficient": true,
      "fullOutput": "Discovery call preparation brief",
      "insufficientOutput": "Discovery readiness gap memo",
      "hardFails": ["generic questionnaire", "re-asking confirmed facts", "unknown presented as fact", "questions not ranked by decision impact", "template substitution"],
      "referenceComponents": ["Approved Finance Discovery Brief example"]
    },
    {
      "artifactType": "rom",
      "adapter": "rom",
      "decisionJob": "State a defensible effort and cost range, explain its basis and confidence, and name what reopens the range.",
      "primaryAudience": ["buyer sponsor", "sales lead", "delivery lead", "finance reviewer"],
      "requiredDomains": ["scope basis", "workstream effort", "role assumptions", "rates or cost basis", "confidence", "range reopeners", "commercial posture"],
      "terminalIfInsufficient": true,
      "fullOutput": "ROM estimate",
      "insufficientOutput": "Estimate readiness gap memo",
      "hardFails": ["fabricated precision", "range without basis", "arithmetic mismatch", "assumption hidden from range", "scenario comparison mislabeled as estimate"],
      "referenceComponents": ["Effort and cost range ROM pattern"]
    },
    {
      "artifactType": "business_case",
      "adapter": "business_case",
      "decisionJob": "Earn a funding recommendation by arguing the case for and against the investment, including the cost and risk of waiting.",
      "primaryAudience": ["economic buyer", "executive sponsor", "funding committee"],
      "requiredDomains": ["recommendation", "current gap", "timing", "benefits", "case against", "cost of waiting", "investment", "approval conditions"],
      "terminalIfInsufficient": true,
      "fullOutput": "Executive business case",
      "insufficientOutput": "Investment readiness gap memo",
      "hardFails": ["invented ROI", "benefits not tied to evidence", "case against omitted", "recommendation without conditions", "example-cloned structure"],
      "referenceComponents": ["Approved subscription Business Case example", "Patient access investment Business Case pattern"]
    },
    {
      "artifactType": "ddoc",
      "adapter": "ddoc",
      "decisionJob": "Frame the buyer's real alternatives, compare them on buyer-owned criteria, recommend a path, and define the decision gate.",
      "primaryAudience": ["economic buyer", "champion", "gatekeeper", "decision committee"],
      "requiredDomains": ["decision", "alternatives", "criteria", "tradeoffs", "recommendation", "scope boundary", "execution implications", "commercials", "decision gate"],
      "terminalIfInsufficient": true,
      "fullOutput": "Deal Decision Document in lean or rich mode",
      "insufficientOutput": "Decision readiness gap memo",
      "hardFails": ["false choice", "recommendation not earned", "criteria invented by vendor", "proposal substituted for decision analysis", "scope or price treated as committed without authority"],
      "referenceComponents": ["Platform choice DDOC pattern", "Contract renewal DDOC pattern", "Foundation scope DDOC pattern", "Software rollout DDOC pattern"]
    },
    {
      "artifactType": "deal_desk",
      "adapter": "deal_desk",
      "decisionJob": "Support one internal commercial decision: approve as offered, approve with conditions, reject as offered, or stop as not ready.",
      "primaryAudience": ["commercial approver", "delivery approver", "sales leadership"],
      "requiredDomains": ["scope", "price", "cost", "margin", "staffing", "capacity", "assumptions", "risks", "protections", "approval action"],
      "terminalIfInsufficient": true,
      "fullOutput": "Deal Desk approval readout",
      "insufficientOutput": "Not ready for Deal Desk approval memo",
      "hardFails": ["arithmetic mismatch", "real margin hidden behind point estimate", "delivery cosign missing", "risk smoothed over", "more than one approval ask"],
      "referenceComponents": ["Commercial approval Deal Desk pattern"]
    },
    {
      "artifactType": "solution_brief",
      "adapter": "solution_brief",
      "mode": "approval_or_build_reference",
      "decisionJob": "Judge technical deliverability and define the critical system shape, boundaries, decisions, failure paths, and inherited risks.",
      "primaryAudience": ["solution architect", "delivery lead", "technical approver", "client technical owner"],
      "requiredDomains": ["scope", "system context", "architecture", "integrations", "data", "security and governance", "decisions", "failure paths", "risks", "assumptions", "technical approval conditions"],
      "terminalIfInsufficient": true,
      "fullOutput": "Solution Brief in approval or build-reference mode",
      "insufficientOutput": "Technical Readiness Memo",
      "hardFails": ["generic architecture", "full brief generated after insufficient gate", "failure paths omitted", "commercial approval claimed", "onboarding content substituted for architecture", "unsupported technical precision"],
      "referenceComponents": ["Approved industrial Solution Brief example", "Technical Readiness Memo pattern"]
    },
    {
      "artifactType": "sales_to_delivery_handoff",
      "adapter": "sales_to_delivery_handoff",
      "decisionJob": "Transfer signed commitments and approved conditions into a safe delivery start without reopening settled ground or hiding unresolved readiness gaps.",
      "primaryAudience": ["delivery lead", "solution architect", "project lead", "sales lead"],
      "requiredDomains": ["executed commitment", "contract baseline", "current operational intent", "approved technical conditions", "approved commercial conditions", "stakeholders and authority", "readiness", "week-one validation backlog"],
      "terminalIfInsufficient": true,
      "fullOutput": "Sales-to-Delivery Handoff",
      "insufficientOutput": "Handoff readiness gap memo",
      "hardFails": ["no executed commitment", "contract silently overridden by recent intent", "solution analysis recreated instead of inherited", "commercial conditions dropped", "conditional readiness without owners and closure outputs"],
      "referenceComponents": ["Sales-to-Delivery Handoff example"]
    }
  ]
}
